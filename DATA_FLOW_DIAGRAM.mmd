flowchart TD
    %% ============================================
    %% EXTERNAL ENTITIES
    %% ============================================
    SR[Sales Representative]
    PA[Pharmacist/Admin]
    SA[System Admin]
    EPG[External Payment Gateway]
    
    %% ============================================
    %% PROCESSES
    %% ============================================
    P1[1.0 User Management<br/>Authentication & Authorization]
    P2[2.0 Order Processing<br/>Cart, Orders, Status]
    P3[3.0 Payment Processing<br/>Submissions & Verification]
    P4[4.0 Inventory Management<br/>Catalog & Stock]
    P5[5.0 Prescription Management<br/>Upload & Verification]
    P6[6.0 Notification System<br/>Real-time Alerts]
    P7[7.0 Analytics & Forecasting<br/>ARIMA & Reports]
    
    %% ============================================
    %% DATA STORES
    %% ============================================
    D1[(D1: User Database<br/>Users, Profiles, Roles)]
    D2[(D2: User Session<br/>Active Sessions)]
    D3[(D3: Cart Database<br/>Cart Items)]
    D4[(D4: Order Database<br/>Orders & Order Items)]
    D5[(D5: Order Status History<br/>Status Changes)]
    D6[(D6: Payment Submission<br/>Payment Records)]
    D7[(D7: Transaction Database<br/>Transactions & Refunds)]
    D8[(D8: File Upload Database<br/>Prescriptions & Receipts)]
    D9[(D9: Medicine Database<br/>Medicine Catalog)]
    D10[(D10: Stock Movement<br/>Stock Changes)]
    D11[(D11: Reorder Alert<br/>Low Stock Alerts)]
    D12[(D12: Category Database<br/>Medicine Categories)]
    D13[(D13: Manufacturer Database<br/>Manufacturers)]
    D14[(D14: Notification Database<br/>Notifications)]
    D15[(D15: Forecast Database<br/>Demand Forecasts)]
    D16[(D16: Analytics Database<br/>Reports & Metrics)]
    
    %% ============================================
    %% USER MANAGEMENT FLOWS
    %% ============================================
    SR -->|Login Credentials| P1
    PA -->|Login Credentials| P1
    SA -->|Login Credentials| P1
    SR -->|Registration Data| P1
    PA -->|Registration Data| P1
    SA -->|User Management| P1
    
    P1 -->|User Data| D1
    P1 -->|Session Data| D2
    D1 -->|User Info| P1
    D2 -->|Session Info| P1
    
    P1 -->|Auth Status| SR
    P1 -->|Auth Status| PA
    P1 -->|Auth Status| SA
    P1 -->|User Profile| SR
    P1 -->|User Profile| PA
    P1 -->|User Management| SA
    
    %% ============================================
    %% ORDER PROCESSING FLOWS
    %% ============================================
    SR -->|Cart Items| P2
    SR -->|Customer Info| P2
