    %% ============================================
    classDef externalEntity fill:#e1f5ff,stroke:#0066cc,stroke-width:2px,color:#000
    classDef process fill:#fff4e1,stroke:#ff6600,stroke-width:2px,color:#000
    classDef dataStore fill:#e1ffe1,stroke:#00cc00,stroke-width:2px,color:#000
    
    class SR,PA,SA,EPG externalEntity
    class P1,P2,P3,P4,P5,P6,P7 process
