flowchart TB
    %% Visual Comparison: Food Ordering vs Medicine Ordering DFD Structure
    
    subgraph FOOD["Food Ordering System (Reference)"]
        F_EE1[Customer]
        F_EE2[Kitchen]
        F_EE3[Manager]
        F_EE4[Supplier]
        
        F_P1[1.0 Order Food]
        F_P2[2.0 Generate Reports]
        F_P3[3.0 Order Inventory]
        
        F_D1[(Orders)]
        F_D2[(Inventory)]
        
        F_EE1 -->|Order| F_P1
        F_P1 -->|Order| F_EE2
        F_P1 -->|Bill| F_EE1
        F_P1 -->|Order Data| F_D1
        F_P1 -->|Updated Inventory| F_D2
        
        F_EE3 -->|Report Request| F_P2
        F_D1 -->|Orders| F_P2
        F_D2 -->|Inventory Details| F_P2
        F_P2 -->|Reports| F_EE3
        
        F_EE3 -->|Inventory Order| F_P3
        F_P3 -->|Inventory Order| F_EE4
        F_P3 -->|Updated Inventory| F_D2
    end
    
    subgraph MEDICINE["Medicine Ordering System (OnCare)"]
        M_EE1[Sales Representative]
        M_EE2[Pharmacist/Admin]
        M_EE3[System Admin]
        M_EE4[Payment Gateway]
        
        M_P1[1.0 Order Medicine]
        M_P2[2.0 Verify Payment]
        M_P3[3.0 Order Inventory]
        M_P4[4.0 Generate Reports]
        
        M_D1[(Orders)]
        M_D2[(Payments)]
        M_D3[(Inventory)]
        M_D4[(Prescriptions)]
        
        M_EE1 -->|Order| M_P1
        M_P1 -->|Order| M_EE2
        M_P1 -->|Bill| M_EE1
        M_P1 -->|Order Data| M_D1
        M_P1 -->|Updated Inventory| M_D3
        M_P1 -->|Prescription Data| M_D4
        
        M_EE1 -->|Payment Information| M_P2
        M_EE2 -->|Payment Verification| M_P2
        M_EE4 -->|Payment Response| M_P2
        M_P2 -->|Payment Data| M_D2
        M_P2 -->|Payment Status| M_EE1
        
        M_EE2 -->|Inventory Order| M_P3
        M_P3 -->|Updated Inventory| M_D3
        M_P3 -->|Inventory Report| M_EE2
        
        M_EE2 -->|Report Request| M_P4
        M_D1 -->|Orders| M_P4
        M_D2 -->|Payments| M_P4
        M_D3 -->|Inventory Details| M_P4
        M_P4 -->|Analytics Report| M_EE2
    end
    
    style FOOD fill:#e6f3ff,stroke:#0066cc,stroke-width:2px
    style MEDICINE fill:#fff4e1,stroke:#ff6600,stroke-width:2px





